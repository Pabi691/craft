# Craft & Weft — main site (craftcombine.org)
#
# The site is a React single-page app built by Vite. Upload the CONTENTS of
# dist/ into public_html/, with this file sitting next to index.html.
#
# This file is not read by api.craftcombine.org or admin.craftcombine.org:
# those subdomains have their own document roots, and Apache never looks at
# .htaccess files above a document root. It is read when someone reaches the
# same folders through craftcombine.org/api/… — hence the guard below.

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8

# ─── Routing ────────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Always HTTPS. The second condition covers Hostinger's proxy, which
  # terminates TLS upstream and passes the original scheme in a header.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # One canonical hostname: www.craftcombine.org → craftcombine.org.
  # Delete this block if you would rather keep www as the main address.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # The backend and the admin panel live in their own folders. Leave their
  # URLs alone so the SPA fallback below never swallows them.
  RewriteRule ^(api|admin)(/|$) - [L]

  # Vite writes every JS/CSS file into assets/ with a content hash in its
  # name, so those files can be cached forever. Flagged here, applied under
  # Caching below.
  RewriteRule ^assets/ - [E=IMMUTABLE:1]

  # A folder with no index.html must never shadow an app route. An uploaded
  # asset folder named tea/ once did exactly that: Apache redirected /tea to
  # /tea/, found no index file, and answered 403 instead of showing the page.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html !-f
  RewriteRule ^ index.html [L]

  # React Router runs in the browser, so /tea, /p/sphoora-udaya, /checkout and
  # every other route must return index.html on a direct hit or a refresh.
  # Real files and real folders with an index are served normally.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# ─── Caching ────────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                      "access plus 1 month"

  # index.html must never be cached: it names the hashed asset files, so a
  # stale copy would keep serving an old build after every deploy.
  ExpiresByType text/html             "access plus 0 seconds"

  ExpiresByType image/jpeg            "access plus 1 month"
  ExpiresByType image/png             "access plus 1 month"
  ExpiresByType image/webp            "access plus 1 month"
  ExpiresByType image/avif            "access plus 1 month"
  ExpiresByType image/svg+xml         "access plus 1 month"
  ExpiresByType font/woff2            "access plus 1 year"
  ExpiresByType text/css              "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable" env=IMMUTABLE
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ─── Compression ────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml font/ttf font/otf
</IfModule>

# ─── Security ───────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), camera=(), microphone=()"
  Header unset X-Powered-By
  Header always unset X-Powered-By

  # Turn on once you are sure every subdomain works over HTTPS. Browsers
  # remember it for two years and will refuse plain HTTP in the meantime.
  # Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
</IfModule>

# Hidden files — .env, .git, editor leftovers — are never served.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# ─── MIME types ─────────────────────────────────────────────────────────────
<IfModule mod_mime.c>
  AddType image/webp              .webp
  AddType image/avif              .avif
  AddType font/woff2              .woff2
  AddType application/manifest+json .webmanifest
</IfModule>
